app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Claude Code session runtime state (not project content)
.claude/

# Generated localization code (regenerated automatically by `flutter pub
# get`/`flutter run` via the `generate: true` flag in pubspec.yaml — unlike
# Drift's build_runner output, this needs no manual build step, so there's
# no reason to commit it).
/lib/l10n/gen/

# Flutter web build served by the landing page (see scripts/build_landing.ps1)
/landing/app/
