<?xml version="1.0" encoding="utf-8"?>
<!-- Where the in-app updater (ota_update) saves a downloaded APK before handing
     it to Android's installer. Internal storage, so no storage permission. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="internal_apk_storage" path="ota_update/"/>
</paths>
